	<ItemGroup>
		<Folder Remove="extras\" />
	</ItemGroup>
	<ItemGroup Condition="Exists('..\ui\dist\index.html')">
		<Content Include="Resources\Logo\*.ico" Link="iconos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="..\ui\dist\**\*" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
